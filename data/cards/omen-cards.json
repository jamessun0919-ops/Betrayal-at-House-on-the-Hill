        "activeEffects": [{ "type": "stat_change", "stat": "knowledge", "delta": 2 }, { "type": "stat_change", "stat": "sanity", "delta": -2 }],
        "inactiveEffects": [{ "type": "stat_change", "stat": "knowledge", "delta": -2 }, { "type": "stat_change", "stat": "sanity", "delta": 2 }]
      }] },
      { "min": 0, "max": 3, "effects": [] }
