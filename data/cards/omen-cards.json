[
  { "id": "omen_001", "name": "噬咬", "text": "這是一個針對玩家的4點力量襲擊，由前一位玩家代擲四粒骰子。若玩家勝出這比拚，此卡無效果。否則玩家如常受到肉體損傷。此卡牌非物品，無法被偷竊或轉交、丟棄。保留此卡以便計算已翻開的邪祟牌數目", "effects": [], "category": "general", "needsCustomLogic": true },
  { "id": "omen_002", "name": "書", "text": "玩家的知識上升兩個級別，如果玩家失去書本，知識下降兩個級別", "effects": [{ "type": "stat_change", "stat": "knowledge", "delta": 2 }], "category": "general", "needsCustomLogic": false },
  { "id": "omen_003", "name": "水晶球", "text": "當玩家使用水晶球時以知識進行考驗，骰數大於等於四，玩家可以從三張隨機事件卡中選擇一張，重新洗牌後將選擇的牌放置於牌堆頂端。骰數１至３：玩家頭昏眼花，意志下降一個級別；骰數０：玩家見到了地獄般的景象，意志下降２級別", "effects": [{
    "type": "dice_check",
    "stat": "knowledge",
    "tiers": [
      { "min": 4, "max": 8, "effects": [{ "type": "preview_and_choose", "deck": "event", "count": 3, "description": "選擇一張事件卡", "timeoutMs": 20000 }] },
      { "min": 1, "max": 3, "effects": [{ "type": "stat_change", "stat": "sanity", "delta": -1 }] },
      { "min": 0, "max": 0, "effects": [{ "type": "stat_change", "stat": "sanity", "delta": -2 }] }
    ]
  }], "activatedOnUse": true, "category": "general", "needsCustomLogic": false },
  { "id": "omen_004", "name": "犬靈", "text": "玩家的力量及意志上升一個級別，如果失去犬靈的追隨，玩家的意志及力量下降一個級別。玩家的回合中可差遣犬靈前往其他房間拾取物品，犬靈不可被丟棄、竊盜或轉交", "effects": [{ "type": "switch_control", "summonType": "spiritDog", "actionPoints": 6 }], "activatedOnUse": true, "category": "general", "needsCustomLogic": false },
  { "id": "omen_005", "name": "女孩", "text": "玩家的意志和知識上升一個級別．如果失去女孩的追隨，知識和意志下降一個級別。不可被偷竊、丟棄和轉交", "effects": [{ "type": "stat_change", "stat": "sanity", "delta": 1 }, { "type": "stat_change", "stat": "knowledge", "delta": 1 }], "category": "general", "needsCustomLogic": false },
  { "id": "omen_006", "name": "聖符", "text": "玩家的意志上升兩個級別，若玩家失去聖符，玩家的意志下降兩個級別", "effects": [{ "type": "stat_change", "stat": "sanity", "delta": 2 }], "category": "general", "needsCustomLogic": false },
  { "id": "omen_007", "name": "瘋漢", "text": "瘋漢跟隨著玩家，力量上升兩個級別，意志下降兩個級別。若失去瘋漢追隨，力量下降兩個級別，意志上升兩個級別。不可被偷竊、丟棄及轉交", "effects": [{ "type": "stat_change", "stat": "might", "delta": 2 }, { "type": "stat_change", "stat": "sanity", "delta": -2 }], "category": "general", "needsCustomLogic": false },
  { "id": "omen_008", "name": "面具", "text": "當玩家使用面具時以意志進行考驗，骰數大於等於四：可以啟動面具效果。生效狀態：知識上升兩個級別，意志下降兩個級別。骰數０～３：狀態不改變", "effects": [{
    "type": "dice_check",
