  }], "activatedOnUse": true, "category": "general", "needsCustomLogic": false },
  { "id": "omen_009", "name": "徽章", "text": "玩家不受五芒星堂、地窖及墓園的影響，通過上述三個房間時不需要進行考驗", "effects": [], "category": "general", "needsCustomLogic": false },
  { "id": "omen_010", "name": "戒指", "text": "玩家在自身的回合可以選擇以意志進行襲擊，如果襲擊成功，敵方受到精神損傷而非肉體損傷，對於無意志的目標無法使用", "effects": [], "category": "weapon", "needsCustomLogic": true },
  { "id": "omen_011", "name": "頭骨", "text": "當玩家受到精神損傷時，可以選擇改受肉體損傷", "effects": [], "category": "general", "needsCustomLogic": true },
  { "id": "omen_012", "name": "長矛", "text": "玩家的回合中選擇以力量進行襲擊時，可多骰兩顆骰子，最多不超過八顆", "effects": [], "category": "weapon", "needsCustomLogic": true },
  { "id": "omen_013", "name": "通靈板", "text": "在玩家移動前，可以檢視房間牌堆最頂上一塊，看過後可以選擇放回頂端或底部。如果遊戲已經進入邪祟階段，在玩家使用此物品後，叛徒可以控制任意數量怪物朝玩家前進一步，如無叛徒，所以怪物必須朝玩家移動一步", "effects": [], "category": "general", "needsCustomLogic": true }
